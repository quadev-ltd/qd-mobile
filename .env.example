EXPO_PUBLIC_APPLICATION_NAME=mobile
EXPO_PUBLIC_APPLICATION_ENVIRONMENT=dev_example
EXPO_PUBLIC_CLIENT_ID=id-id_number.apps.googleusercontent.com
EXPO_PUBLIC_DEEP_LINKING_DOMAIN=quadevdomain
# Not read by the app; only the native parity script (scripts/parity) uses it to mask its value.
EXPO_PUBLIC_REVERSED_CLIENT_ID=com.googleusercontent.apps.id_number-id
# Optional: "true" points Auth, Firestore and Functions at the local Firebase emulators.
# Set it on the command line for an emulator build instead of committing it to .env.dev.
# EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
