{
  "name": "qd-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev": "dotenv -e .env.dev -v APP_VARIANT=development -- expo start",
    "start:prod": "dotenv -e .env.prod -v APP_VARIANT=production -- expo start",
    "android:dev": "dotenv -e .env.dev -v APP_VARIANT=development -- expo run:android",
    "android:prod": "dotenv -e .env.prod -v APP_VARIANT=production -- expo run:android",
    "ios:dev": "dotenv -e .env.dev -v APP_VARIANT=development -- expo run:ios",
    "ios:prod": "dotenv -e .env.prod -v APP_VARIANT=production -- expo run:ios",
    "prebuild:dev": "dotenv -e .env.dev -v APP_VARIANT=development -- expo prebuild --clean",
    "prebuild:prod": "dotenv -e .env.prod -v APP_VARIANT=production -- expo prebuild --clean",
    "parity:dev": "dotenv -e .env.dev -- zsh scripts/parity/parity.zsh check development",
    "parity:prod": "dotenv -e .env.prod -- zsh scripts/parity/parity.zsh check production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "expo-doctor",
    "postinstall": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@formatjs/intl-locale": "^3.4.3",
    "@formatjs/intl-pluralrules": "^5.2.10",
    "@hookform/resolvers": "^3.3.4",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/functions": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@react-navigation/drawer": "^7.14.3",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@reduxjs/toolkit": "2.0.1",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-image-picker": "~57.0.20",
    "expo-system-ui": "~57.0.4",
    "i18next": "^23.7.6",
    "react": "19.2.3",
    "react-hook-form": "^7.51.2",
    "react-i18next": "^13.5.0",
    "react-native": "0.86.3",
    "react-native-bootsplash": "^7.3.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mask-input": "^1.2.3",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^3.0.0-beta.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "9.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/runtime": "^7.25.0",
    "@react-native/eslint-config": "0.76.6",
    "@react-native/jest-preset": "~0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/intl": "^1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.4",
    "@types/react-redux": "^7.1.32",
    "@types/react-test-renderer": "^19",
    "@types/redux-mock-store": "^1",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~57.0.0",
    "dotenv": "^16.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-ft-flow": "^2.0.1",
    "eslint-plugin-i18next": "^6.0.3",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.1.1",
    "react-test-renderer": "19.2.3",
    "redux-mock-store": "^1.5.4",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "yarn@4.6.0",
  "main": "index.ts",
  "expo": {
    "install": {
      "exclude": [
        "react-native-bootsplash"
      ]
    }
  }
}
