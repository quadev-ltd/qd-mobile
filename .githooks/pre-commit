#!/bin/sh
# Blocks commits that contain secrets. Enabled by `yarn install` (postinstall sets core.hooksPath).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, secret scan skipped (brew install gitleaks)." >&2
  exit 0
fi
gitleaks git --pre-commit --staged --redact --no-banner || {
  echo "pre-commit: possible secret in staged changes. Remove it, or add a reviewed allowlist entry to .gitleaks.toml." >&2
  exit 1
}
